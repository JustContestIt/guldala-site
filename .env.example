# The CRM (../crm) serves prices, stock and orders through /public/* (docs/crm-contract.md).
# In crm/deploy/docker-compose.yml both come from deploy/.env; here — the CRM from `npm run dev` next door.
CRM_URL=http://localhost:3001
CRM_PUBLIC_SECRET=dev-secret

# Address of this site for canonical links and sitemap (default https://guldala.kz). Docker: a build arg from DOMAIN
# SITE_URL=http://localhost:3000
